  "scripts": {
    "start": "env-cmd -f .env.prod craco start",
    "dev": "env-cmd -f .env.development craco start",
    "devuser": "env-cmd -f .env.usermgmt craco start",
    "sandbox": "env-cmd -f .env.sandbox craco start",
    "demodev": "env-cmd -f .env.demodev craco start",
    "customer": "env-cmd -f .env.customer craco start",
    "build": "cp .env.prod .env && react-scripts build",
    "build:dev": "cp .env.development .env && react-scripts build",
    "build:user": "cp .env.usermgmt .env && react-scripts build",
    "build:sandbox": "cp .env.sandbox .env && react-scripts build",
    "build:demodev": "cp .env.demodev .env && react-scripts build",
    "build:customer": "cp .env.customer .env && react-scripts build",
    "format": "prettier --write \"src/**/*.tsx\"",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
